# Copy to .env.local for local development (gitignored — never commit real values).

# Base URL the axios client (src/lib/api-client.ts) sends requests to.
# Defaults to /api/v1 (same-origin) if unset — set this when the backend
# runs on a different host/port than the frontend dev server.
VITE_API_BASE_URL=http://localhost:8080/api/v1
