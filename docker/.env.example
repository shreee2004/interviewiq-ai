# Copy to docker/.env and fill in real values. docker/.env is gitignored —
# never commit real secrets.

# --- Database ---
DB_NAME=interviewiq
DB_USERNAME=interviewiq
DB_PASSWORD=interviewiq

# --- Auth (required once the auth module issues real tokens — Phase 2) ---
JWT_SECRET=change-me-to-a-long-random-string

# --- Google OAuth (optional until Google login is wired up) ---
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# --- AI provider (required once AI integration lands — Phase 4) ---
AI_PROVIDER=openai
OPENAI_API_KEY=
GEMINI_API_KEY=
